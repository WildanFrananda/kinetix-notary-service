#!/usr/bin/env sh
set -eu

HERE="$(cd "$(dirname "$0")/.." && pwd)"

: "${KINETIX_NOTARY_KEYSTORE_DIR:?set KINETIX_NOTARY_KEYSTORE_DIR to an existing directory outside every repository}"
if [ ! -d "$KINETIX_NOTARY_KEYSTORE_DIR" ]; then
  echo "KINETIX_NOTARY_KEYSTORE_DIR is not a directory: $KINETIX_NOTARY_KEYSTORE_DIR" >&2
  exit 1
fi
dir="$(cd "$KINETIX_NOTARY_KEYSTORE_DIR" && pwd)"
case "$dir/" in
  "$HERE"/*)
    echo "refusing a keystore directory inside this repository: $dir" >&2
    exit 1
    ;;
esac
if git -C "$dir" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  echo "refusing a keystore directory inside a git work tree: $dir" >&2
  exit 1
fi
printf '%s\n' "$dir"
