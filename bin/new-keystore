#!/usr/bin/env sh
set -eu

HERE="$(cd "$(dirname "$0")/.." && pwd)"
NAME="${1:-}"

case "$NAME" in
  notary-deployer | notary-admin) ;;
  *)
    echo "usage: bin/new-keystore <notary-deployer|notary-admin>" >&2
    echo "the anchorer is a hot key and lives in SOPS: bin/new-anchorer-key" >&2
    exit 64
    ;;
esac

KEYSTORES="$(sh "$HERE/bin/keystore-dir")"
if [ -e "$KEYSTORES/$NAME" ]; then
  echo "$KEYSTORES/$NAME already exists; a key is never overwritten" >&2
  exit 1
fi

docker compose -f "$HERE/toolchain/compose.yaml" build --quiet toolchain >&2
exec docker compose -f "$HERE/toolchain/compose.yaml" run --rm --no-deps \
  -v "$KEYSTORES:/keystores" \
  toolchain cast wallet new /keystores "$NAME"
