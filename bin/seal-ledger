#!/usr/bin/env sh
set -eu

HERE="$(cd "$(dirname "$0")/.." && pwd)"
NETWORK="${1:-}"
HEAD="${2:-}"
MODE="${3:-}"

case "$MODE" in
  "" | --broadcast) ;;
  *)
    echo "usage: bin/seal-ledger <network> <head> [--broadcast]" >&2
    exit 64
    ;;
esac
if [ -z "$NETWORK" ] || [ ! -f "$HERE/deploy/$NETWORK.env" ] || [ -z "$HEAD" ]; then
  echo "usage: bin/seal-ledger <network> <head> [--broadcast]   (reads deploy/<network>.env; <head> is the digest to seal at)" >&2
  exit 64
fi
: "${KINETIX_NOTARY_RPC_URL:?set KINETIX_NOTARY_RPC_URL to the network RPC endpoint}"
KEYSTORES="$(sh "$HERE/bin/keystore-dir")"
if [ ! -f "$KEYSTORES/notary-admin" ]; then
  echo "no notary-admin keystore in $KEYSTORES: only the ledger's admin seals it" >&2
  exit 1
fi

set -- run --rm --no-deps -e KINETIX_NOTARY_RPC_URL -v "$KEYSTORES:/keystores:ro"
PASSWORD_ARG=""
if [ -n "${KINETIX_NOTARY_KEYSTORE_PASSWORD_FILE:-}" ]; then
  set -- "$@" -v "$KINETIX_NOTARY_KEYSTORE_PASSWORD_FILE:/run/keystore-password:ro"
  PASSWORD_ARG=--password-file
fi

docker compose -f "$HERE/toolchain/compose.yaml" build --quiet toolchain >&2
exec docker compose -f "$HERE/toolchain/compose.yaml" "$@" toolchain sh -c '
  set -eu
  network="$1"
  head="$2"
  mode="$3"
  password_arg="$4"
  set -a
  . "./deploy/$network.env"
  set +a
  for key in KINETIX_NOTARY_CHAIN_ID KINETIX_NOTARY_LEDGER_ADDRESS KINETIX_NOTARY_ADMIN_ADDRESS; do
    eval "value=\${$key:-}"
    if [ -z "$value" ]; then
      echo "$key is empty in deploy/$network.env" >&2
      exit 78
    fi
  done
  rpc="$KINETIX_NOTARY_RPC_URL"
  ledger="$KINETIX_NOTARY_LEDGER_ADDRESS"
  served="$(cast chain-id --rpc-url "$rpc")"
  if [ "$served" != "$KINETIX_NOTARY_CHAIN_ID" ]; then
    echo "the RPC endpoint serves chain $served, deploy/$network.env is for chain $KINETIX_NOTARY_CHAIN_ID" >&2
    exit 1
  fi
  if [ "$(cast call "$ledger" "isSealed()(bool)" --rpc-url "$rpc")" = "true" ]; then
    echo "the ledger at $ledger is sealed already; nothing to do"
    exit 0
  fi
  current="$(cast call "$ledger" "head()(bytes32)" --rpc-url "$rpc")"
  next="$(cast call "$ledger" "nextEpoch()(uint64)" --rpc-url "$rpc" | sed "s/ \[.*\]\$//")"
  last="$(cast call "$ledger" "lastAsOf()(uint64)" --rpc-url "$rpc" | sed "s/ \[.*\]\$//")"
  if [ "$(printf %s "$current" | tr A-F a-f)" != "$(printf %s "$head" | tr A-F a-f)" ]; then
    echo "the head of $ledger is $current (next epoch $next), not $head: an epoch landed since you read it" >&2
    exit 1
  fi

  cast call "$ledger" "seal(bytes32)" "$head" --from "$KINETIX_NOTARY_ADMIN_ADDRESS" --rpc-url "$rpc" >/dev/null
  if [ "$mode" != "--broadcast" ]; then
    echo "dry run: the admin $KINETIX_NOTARY_ADMIN_ADDRESS may seal $ledger at head $head."
    echo "the successor starts at epoch $next, from digest $head and snapshot $last."
    echo "sealing is permanent: the ledger anchors nothing after it. Nothing was sent; re-run with --broadcast to seal."
    exit 0
  fi

  set -- "$ledger" "seal(bytes32)" "$head" --rpc-url "$rpc" --keystore /keystores/notary-admin
  if [ -n "$password_arg" ]; then
    set -- "$@" --password-file /run/keystore-password
  fi
  cast send "$@"
  waited=0
  until [ "$(cast call "$ledger" "isSealed()(bool)" --rpc-url "$rpc")" = "true" ]; do
    if [ "$waited" -ge 60 ]; then
      echo "the seal was sent, but $ledger is not sealed at the latest block after 60 s" >&2
      exit 1
    fi
    sleep 2
    waited=$((waited + 2))
  done
  echo "$ledger is sealed at $head; its successor starts at epoch $next"
' sh "$NETWORK" "$HEAD" "$MODE" "$PASSWORD_ARG"
