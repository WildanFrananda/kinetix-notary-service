#!/usr/bin/env sh
set -eu

HERE="$(cd "$(dirname "$0")/.." && pwd)"
NETWORK="${1:-}"

if [ -z "$NETWORK" ] || [ ! -f "$HERE/deploy/$NETWORK.env" ]; then
  echo "usage: bin/inspect-withholding <network>   (reads deploy/<network>.env)" >&2
  exit 64
fi
: "${KINETIX_NOTARY_RPC_URL:?set KINETIX_NOTARY_RPC_URL to the network RPC endpoint}"

docker compose -f "$HERE/toolchain/compose.yaml" build --quiet toolchain >&2
exec docker compose -f "$HERE/toolchain/compose.yaml" run --rm --no-deps -T \
  -e KINETIX_NOTARY_RPC_URL toolchain sh -c '
  set -eu
  network="$1"
  set -a
  . "./deploy/$network.env"
  set +a
  court="${KINETIX_NOTARY_WITHHOLDING_COURT_ADDRESS:-}"
  if [ -z "$court" ]; then
    echo "KINETIX_NOTARY_WITHHOLDING_COURT_ADDRESS is empty in deploy/$network.env" >&2
    exit 78
  fi
  rpc="$KINETIX_NOTARY_RPC_URL"
  failed=0
  expect() {
    if [ "$(printf %s "$2" | tr A-F a-f)" = "$(printf %s "$3" | tr A-F a-f)" ]; then
      printf "  ok    %-22s %s\n" "$1" "$2"
    else
      printf "  WRONG %-22s %s (expected %s)\n" "$1" "$2" "$3"
      failed=1
    fi
  }
  show() {
    printf "        %-22s %s\n" "$1" "$2"
  }
  call() {
    cast call "$court" "$@" --rpc-url "$rpc" | sed "s/ \[.*\]\$//"
  }

  echo "withholding court $court on deploy/$network.env"
  expect "chain id" "$(cast chain-id --rpc-url "$rpc")" "$KINETIX_NOTARY_CHAIN_ID"
  code="$(cast code "$court" --rpc-url "$rpc")"
  if [ "$code" = "0x" ]; then
    echo "  WRONG no contract at $court"
    exit 1
  fi
  show "code bytes" "$(( (${#code} - 2) / 2 ))"
  expect "beside the court" "$(call "court()(address)")" "$KINETIX_NOTARY_COURT_ADDRESS"
  expect "reads the ledger" "$(call "ledger()(address)")" "$KINETIX_NOTARY_LEDGER_ADDRESS"
  expect "request window" "$(call "requestWindow()(uint64)")" "$KINETIX_NOTARY_WITHHOLDING_REQUEST_WINDOW_SECONDS"
  expect "answer period" "$(call "answerPeriod()(uint64)")" "$KINETIX_NOTARY_WITHHOLDING_ANSWER_PERIOD_SECONDS"
  domain="$(cast call "$court" "eip712Domain()(bytes1,string,string,uint256,address,bytes32,uint256[])" --rpc-url "$rpc" | sed -n 2,3p | tr -d "\"" | paste -sd/ -)"
  expect "registration domain" "$domain" "Kinetix Withholding Court/1"
  if [ -n "${KINETIX_NOTARY_ANSWERER_ADDRESS:-}" ]; then
    show "answerer balance" "$(cast balance --ether "$KINETIX_NOTARY_ANSWERER_ADDRESS" --rpc-url "$rpc") ETH"
  fi
  show "recorded silences" "$(call "totalSilences()(uint256)")"
  if [ "${KINETIX_NOTARY_VERIFY_SOURCE:-}" = "true" ] && [ "${KINETIX_NOTARY_VERIFIER:-}" = "sourcify" ]; then
    verdict="$(curl -fsS --max-time 30 "https://sourcify.dev/server/v2/contract/$KINETIX_NOTARY_CHAIN_ID/$court" \
      | python3 -c "import json, sys; print(json.load(sys.stdin).get(\"runtimeMatch\") or \"none\")" 2>/dev/null \
      || echo "unreachable")"
    case "$verdict" in
      match | exact_match) expect "source on sourcify" "$verdict" "$verdict" ;;
      unreachable) printf "  ?     %-22s %s\n" "source on sourcify" "sourcify could not be asked" ; failed=1 ;;
      *) expect "source on sourcify" "$verdict" "match" ;;
    esac
  fi
  exit "$failed"
' sh "$NETWORK"
