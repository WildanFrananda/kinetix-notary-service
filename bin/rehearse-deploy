#!/usr/bin/env sh
set -eu

HERE="$(cd "$(dirname "$0")/.." && pwd)"
PORT=8597
RPC="http://127.0.0.1:$PORT"
SENDER=0x70997970C51812dc3A010C7d01b50e0d17dc79C8

WORK="$(mktemp -d)"
cp -R "$HERE/contracts/." "$WORK"
rm -rf "$WORK/broadcast" "$WORK/cache" "$WORK/out"

trap 'if [ -f "$WORK/anvil.pid" ]; then kill "$(cat "$WORK/anvil.pid")" 2>/dev/null || true; fi; rm -rf "$WORK"' EXIT

expect_create2() {
  python3 - "$WORK/broadcast/$1/$2/run-latest.json" <<'PY'
import json
import sys

factory = "0x4e59b44847b379578588920ca78fbf26c0b4956c"
record = json.load(open(sys.argv[1]))
sent = record["transactions"]
kinds = [(tx["transactionType"], (tx["transaction"].get("to") or "").lower()) for tx in sent]

if kinds != [("CREATE2", factory)]:
    print(f"expected one CREATE2 through {factory}, the broadcast was {kinds}", file=sys.stderr)
    sys.exit(1)

print(record["returns"]["0"]["value"])
PY
}

deployed_at() {
  if [ "$(cast code "$1" --rpc-url "$RPC")" = "0x" ]; then
    echo "the script returned $1 and nothing is there" >&2
    exit 1
  fi
}

for file in "$HERE"/deploy/*.env; do
  network="$(basename "$file" .env)"
  (
    set -a
    . "$file"
    set +a

    anvil --port "$PORT" --silent --chain-id "$KINETIX_NOTARY_CHAIN_ID" --auto-impersonate &
    echo "$!" > "$WORK/anvil.pid"
    until cast chain-id --rpc-url "$RPC" > /dev/null 2>&1; do
      sleep 1
    done

    cd "$WORK"
    forge script script/DeployLiabilityLedger.s.sol:DeployLiabilityLedger \
      --rpc-url "$RPC" \
      --unlocked \
      --sender "$SENDER" \
      --broadcast \
      --slow > /dev/null
    ledger="$(expect_create2 DeployLiabilityLedger.s.sol "$KINETIX_NOTARY_CHAIN_ID")"
    deployed_at "$ledger"

    KINETIX_NOTARY_LEDGER_ADDRESS="$ledger" forge script script/DeployStatementCourt.s.sol:DeployStatementCourt \
      --rpc-url "$RPC" \
      --unlocked \
      --sender "$SENDER" \
      --broadcast \
      --slow > /dev/null
    court="$(expect_create2 DeployStatementCourt.s.sol "$KINETIX_NOTARY_CHAIN_ID")"
    deployed_at "$court"

    if [ "$(cast call "$court" 'ledger()(address)' --rpc-url "$RPC")" != "$ledger" ]; then
      echo "the rehearsed court at $court does not judge the rehearsed ledger $ledger" >&2
      exit 1
    fi

    KINETIX_NOTARY_COURT_ADDRESS="$court" forge script script/DeployWithholdingCourt.s.sol:DeployWithholdingCourt \
      --rpc-url "$RPC" \
      --unlocked \
      --sender "$SENDER" \
      --broadcast \
      --slow > /dev/null
    withholding="$(expect_create2 DeployWithholdingCourt.s.sol "$KINETIX_NOTARY_CHAIN_ID")"
    deployed_at "$withholding"

    if [ "$(cast call "$withholding" 'court()(address)' --rpc-url "$RPC")" != "$court" ]; then
      echo "the rehearsed withholding court at $withholding does not stand beside the rehearsed court $court" >&2
      exit 1
    fi

    if [ -z "${KINETIX_NOTARY_COUNCIL_MEMBERS:-}" ]; then
      echo "deploy/$network.env names no council members: run bin/new-watch-key, then set KINETIX_NOTARY_WATCH_ADDRESS and KINETIX_NOTARY_COUNCIL_MEMBERS" >&2
      exit 1
    fi

    KINETIX_NOTARY_LEDGER_ADDRESS="$ledger" forge script script/DeployAnchorCouncil.s.sol:DeployAnchorCouncil \
      --rpc-url "$RPC" \
      --unlocked \
      --sender "$SENDER" \
      --broadcast \
      --slow > /dev/null
    council="$(expect_create2 DeployAnchorCouncil.s.sol "$KINETIX_NOTARY_CHAIN_ID")"
    deployed_at "$council"

    if [ "$(cast call "$council" 'ledger()(address)' --rpc-url "$RPC")" != "$ledger" ]; then
      echo "the rehearsed council at $council does not stand beside the rehearsed ledger $ledger" >&2
      exit 1
    fi

    KINETIX_NOTARY_LEDGER_ADDRESS="$ledger" \
      KINETIX_NOTARY_COURT_ADDRESS="$court" \
      KINETIX_NOTARY_WITHHOLDING_COURT_ADDRESS="$withholding" \
      forge script script/DeployLedgerDirectory.s.sol:DeployLedgerDirectory \
      --rpc-url "$RPC" \
      --unlocked \
      --sender "$SENDER" \
      --broadcast \
      --slow > /dev/null
    directory="$(expect_create2 DeployLedgerDirectory.s.sol "$KINETIX_NOTARY_CHAIN_ID")"
    deployed_at "$directory"

    generation="$(cast call "$directory" 'current()((uint64,address,address,address,uint64,bytes32,uint16,uint64))' --rpc-url "$RPC")"
    case "$generation" in
      *"$ledger, $court, $withholding,"*) ;;
      *)
        echo "the rehearsed directory at $directory does not start from the rehearsed ledger and courts: $generation" >&2
        exit 1
        ;;
    esac

    for pinned in "$KINETIX_NOTARY_ENTRY_POINT_ADDRESS:EntryPoint" "$KINETIX_NOTARY_7702_ACCOUNT_ADDRESS:Simple7702Account"; do
      cast rpc anvil_setCode "${pinned%%:*}" "$(forge inspect "${pinned#*:}" deployedBytecode)" --rpc-url "$RPC" > /dev/null
    done

    KINETIX_NOTARY_COURT_ADDRESS="$court" \
      KINETIX_NOTARY_WITHHOLDING_COURT_ADDRESS="$withholding" \
      forge script script/DeployNotaryPaymaster.s.sol:DeployNotaryPaymaster \
      --rpc-url "$RPC" \
      --unlocked \
      --sender "$SENDER" \
      --broadcast \
      --slow > /dev/null
    paymaster="$(expect_create2 DeployNotaryPaymaster.s.sol "$KINETIX_NOTARY_CHAIN_ID")"
    deployed_at "$paymaster"

    if [ "$(cast call "$paymaster" 'withholding()(address)' --rpc-url "$RPC")" != "$withholding" ]; then
      echo "the rehearsed paymaster at $paymaster does not sponsor the rehearsed withholding court $withholding" >&2
      exit 1
    fi

    admin="$KINETIX_NOTARY_PAYMASTER_ADMIN_ADDRESS"
    cast rpc anvil_setBalance "$admin" "$(cast to-hex "$(python3 -c "import sys; print(int(sys.argv[1]) * 2)" "$KINETIX_NOTARY_PAYMASTER_STAKE_WEI")")" \
      --rpc-url "$RPC" > /dev/null
    cast send "$paymaster" 'addStake()' --value "$KINETIX_NOTARY_PAYMASTER_STAKE_WEI" --from "$admin" --unlocked \
      --rpc-url "$RPC" > /dev/null
    stake="$(cast call "$KINETIX_NOTARY_ENTRY_POINT_ADDRESS" 'getDepositInfo(address)(uint256,bool,uint112,uint32,uint48)' \
      "$paymaster" --rpc-url "$RPC" | sed 's/ \[.*\]$//' | sed -n 2,4p | paste -sd' ' -)"
    if [ "$stake" != "true $KINETIX_NOTARY_PAYMASTER_STAKE_WEI $KINETIX_NOTARY_PAYMASTER_UNSTAKE_DELAY_SECONDS" ]; then
      echo "the admin staked the rehearsed paymaster and the EntryPoint shows (staked, stake, delay) $stake" >&2
      exit 1
    fi

    evidence_anchorer="${KINETIX_NOTARY_EVIDENCE_ANCHORER_ADDRESS:-}"
    if [ -z "$evidence_anchorer" ]; then
      evidence_anchorer="$SENDER"
      echo "deploy/$network.env names no evidence anchorer yet (bin/new-evidence-anchorer-key); rehearsing with $SENDER" >&2
    fi
    KINETIX_NOTARY_EVIDENCE_ANCHORER_ADDRESS="$evidence_anchorer" \
      forge script script/DeployEvidenceRegistry.s.sol:DeployEvidenceRegistry \
      --rpc-url "$RPC" \
      --unlocked \
      --sender "$SENDER" \
      --broadcast \
      --slow > /dev/null
    registry="$(expect_create2 DeployEvidenceRegistry.s.sol "$KINETIX_NOTARY_CHAIN_ID")"
    deployed_at "$registry"

    if [ "$(cast call "$registry" 'streams()(uint8[])' --rpc-url "$RPC")" != "[1, 2, 3]" ]; then
      echo "the rehearsed evidence registry at $registry does not carry the three streams" >&2
      exit 1
    fi

    role="$(cast call "$registry" 'ANCHORER_ROLE()(bytes32)' --rpc-url "$RPC")"
    if [ "$(cast call "$registry" 'hasRole(bytes32,address)(bool)' "$role" "$evidence_anchorer" --rpc-url "$RPC")" != "true" ]; then
      echo "the rehearsed evidence registry at $registry did not grant $evidence_anchorer its anchorer role" >&2
      exit 1
    fi

    kill "$(cat "$WORK/anvil.pid")"
    echo "$network (chain $KINETIX_NOTARY_CHAIN_ID): ledger $ledger, court $court, withholding court $withholding, council $council, directory $directory, paymaster $paymaster and evidence registry $registry, all through the CREATE2 factory; the paymaster staked by its admin"
  )
done
