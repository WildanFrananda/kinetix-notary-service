#!/usr/bin/env sh
set -eu

HERE="$(cd "$(dirname "$0")/.." && pwd)"
GEN="$HERE/internal/contractgen"
WORK="$(mktemp -d)"
trap 'rm -rf "$WORK"' EXIT

cd "$HERE/contracts"
forge build --silent
forge inspect LiabilityLedger abi --json > "$WORK/LiabilityLedger.abi"
forge inspect LiabilityLedger bytecode > "$WORK/LiabilityLedger.bin"
forge inspect ILiabilityLedger abi --json > "$WORK/ILiabilityLedger.abi"
forge inspect StatementCourt abi --json > "$WORK/StatementCourt.abi"
forge inspect StatementCourt bytecode > "$WORK/StatementCourt.bin"
forge inspect IStatementCourt abi --json > "$WORK/IStatementCourt.abi"
forge inspect WithholdingCourt abi --json > "$WORK/WithholdingCourt.abi"
forge inspect WithholdingCourt bytecode > "$WORK/WithholdingCourt.bin"
forge inspect IWithholdingCourt abi --json > "$WORK/IWithholdingCourt.abi"
forge inspect AnchorCouncil abi --json > "$WORK/AnchorCouncil.abi"
forge inspect AnchorCouncil bytecode > "$WORK/AnchorCouncil.bin"
forge inspect IAnchorCouncil abi --json > "$WORK/IAnchorCouncil.abi"
forge inspect LedgerDirectory abi --json > "$WORK/LedgerDirectory.abi"
forge inspect LedgerDirectory bytecode > "$WORK/LedgerDirectory.bin"
forge inspect ILedgerDirectory abi --json > "$WORK/ILedgerDirectory.abi"
forge inspect NotaryPaymaster abi --json > "$WORK/NotaryPaymaster.abi"
forge inspect NotaryPaymaster bytecode > "$WORK/NotaryPaymaster.bin"
forge inspect INotaryPaymaster abi --json > "$WORK/INotaryPaymaster.abi"
forge inspect IPaymaster abi --json > "$WORK/IPaymaster.abi"
forge inspect EntryPoint abi --json > "$WORK/EntryPoint.abi"
forge inspect EntryPoint bytecode > "$WORK/EntryPoint.bin"
forge inspect Simple7702Account abi --json > "$WORK/Simple7702Account.abi"
forge inspect Simple7702Account bytecode > "$WORK/Simple7702Account.bin"
forge inspect EvidenceRegistry abi --json > "$WORK/EvidenceRegistry.abi"
forge inspect EvidenceRegistry bytecode > "$WORK/EvidenceRegistry.bin"
forge inspect IEvidenceRegistry abi --json > "$WORK/IEvidenceRegistry.abi"
forge inspect LiabilityLedgerV2 abi --json > "$WORK/LiabilityLedgerV2.abi"
forge inspect LiabilityLedgerV2 bytecode > "$WORK/LiabilityLedgerV2.bin"
forge inspect ConfidentialAnchorCouncil abi --json > "$WORK/ConfidentialAnchorCouncil.abi"
forge inspect ConfidentialAnchorCouncil bytecode > "$WORK/ConfidentialAnchorCouncil.bin"
forge inspect TestPlonkVerifier abi --json > "$WORK/TestPlonkVerifier.abi"
forge inspect TestPlonkVerifier bytecode > "$WORK/TestPlonkVerifier.bin"
forge inspect PlonkVerifier abi --json > "$WORK/PlonkVerifier.abi"
forge inspect PlonkVerifier bytecode > "$WORK/PlonkVerifier.bin"

rm -rf "$GEN"
mkdir -p \
  "$GEN/ledger" \
  "$GEN/ledgerinterface" \
  "$GEN/court" \
  "$GEN/courtinterface" \
  "$GEN/withholding" \
  "$GEN/withholdinginterface" \
  "$GEN/council" \
  "$GEN/councilinterface" \
  "$GEN/directory" \
  "$GEN/directoryinterface" \
  "$GEN/paymaster" \
  "$GEN/paymasterinterface" \
  "$GEN/paymasterbase" \
  "$GEN/entrypoint" \
  "$GEN/account7702" \
  "$GEN/evidence" \
  "$GEN/evidenceinterface" \
  "$GEN/ledgertwo" \
  "$GEN/counciltwo" \
  "$GEN/testverifier" \
  "$GEN/plonkverifier"
abigen --v2 \
  --abi "$WORK/LiabilityLedger.abi" \
  --bin "$WORK/LiabilityLedger.bin" \
  --pkg ledger \
  --type LiabilityLedger \
  --out "$GEN/ledger/liability_ledger.go"
abigen --v2 \
  --abi "$WORK/ILiabilityLedger.abi" \
  --pkg ledgerinterface \
  --type ILiabilityLedger \
  --out "$GEN/ledgerinterface/iliability_ledger.go"
abigen --v2 \
  --abi "$WORK/StatementCourt.abi" \
  --bin "$WORK/StatementCourt.bin" \
  --pkg court \
  --type StatementCourt \
  --out "$GEN/court/statement_court.go"
abigen --v2 \
  --abi "$WORK/IStatementCourt.abi" \
  --pkg courtinterface \
  --type IStatementCourt \
  --out "$GEN/courtinterface/istatement_court.go"
abigen --v2 \
  --abi "$WORK/WithholdingCourt.abi" \
  --bin "$WORK/WithholdingCourt.bin" \
  --pkg withholding \
  --type WithholdingCourt \
  --out "$GEN/withholding/withholding_court.go"
abigen --v2 \
  --abi "$WORK/IWithholdingCourt.abi" \
  --pkg withholdinginterface \
  --type IWithholdingCourt \
  --out "$GEN/withholdinginterface/iwithholding_court.go"
abigen --v2 \
  --abi "$WORK/AnchorCouncil.abi" \
  --bin "$WORK/AnchorCouncil.bin" \
  --pkg council \
  --type AnchorCouncil \
  --out "$GEN/council/anchor_council.go"
abigen --v2 \
  --abi "$WORK/IAnchorCouncil.abi" \
  --pkg councilinterface \
  --type IAnchorCouncil \
  --out "$GEN/councilinterface/ianchor_council.go"
abigen --v2 \
  --abi "$WORK/LedgerDirectory.abi" \
  --bin "$WORK/LedgerDirectory.bin" \
  --pkg directory \
  --type LedgerDirectory \
  --out "$GEN/directory/ledger_directory.go"
abigen --v2 \
  --abi "$WORK/ILedgerDirectory.abi" \
  --pkg directoryinterface \
  --type ILedgerDirectory \
  --out "$GEN/directoryinterface/iledger_directory.go"
abigen --v2 \
  --abi "$WORK/NotaryPaymaster.abi" \
  --bin "$WORK/NotaryPaymaster.bin" \
  --pkg paymaster \
  --type NotaryPaymaster \
  --out "$GEN/paymaster/notary_paymaster.go"
abigen --v2 \
  --abi "$WORK/INotaryPaymaster.abi" \
  --pkg paymasterinterface \
  --type INotaryPaymaster \
  --out "$GEN/paymasterinterface/inotary_paymaster.go"
abigen --v2 \
  --abi "$WORK/IPaymaster.abi" \
  --pkg paymasterbase \
  --type IPaymaster \
  --out "$GEN/paymasterbase/ipaymaster.go"
abigen --v2 \
  --abi "$WORK/EntryPoint.abi" \
  --bin "$WORK/EntryPoint.bin" \
  --pkg entrypoint \
  --type EntryPoint \
  --out "$GEN/entrypoint/entry_point.go"
abigen --v2 \
  --abi "$WORK/Simple7702Account.abi" \
  --bin "$WORK/Simple7702Account.bin" \
  --pkg account7702 \
  --type Simple7702Account \
  --out "$GEN/account7702/simple_7702_account.go"
abigen --v2 \
  --abi "$WORK/EvidenceRegistry.abi" \
  --bin "$WORK/EvidenceRegistry.bin" \
  --pkg evidence \
  --type EvidenceRegistry \
  --out "$GEN/evidence/evidence_registry.go"
abigen --v2 \
  --abi "$WORK/IEvidenceRegistry.abi" \
  --pkg evidenceinterface \
  --type IEvidenceRegistry \
  --out "$GEN/evidenceinterface/ievidence_registry.go"

abigen --v2 \
  --abi "$WORK/LiabilityLedgerV2.abi" \
  --bin "$WORK/LiabilityLedgerV2.bin" \
  --pkg ledgertwo \
  --type LiabilityLedgerV2 \
  --out "$GEN/ledgertwo/liability_ledger_v2.go"
abigen --v2 \
  --abi "$WORK/ConfidentialAnchorCouncil.abi" \
  --bin "$WORK/ConfidentialAnchorCouncil.bin" \
  --pkg counciltwo \
  --type ConfidentialAnchorCouncil \
  --out "$GEN/counciltwo/confidential_anchor_council.go"
abigen --v2 \
  --abi "$WORK/TestPlonkVerifier.abi" \
  --bin "$WORK/TestPlonkVerifier.bin" \
  --pkg testverifier \
  --type TestPlonkVerifier \
  --out "$GEN/testverifier/test_plonk_verifier.go"
abigen --v2 \
  --abi "$WORK/PlonkVerifier.abi" \
  --bin "$WORK/PlonkVerifier.bin" \
  --pkg plonkverifier \
  --type PlonkVerifier \
  --out "$GEN/plonkverifier/plonk_verifier.go"

echo "generated $GEN"
