#!/usr/bin/env sh
set -eu

HERE="$(cd "$(dirname "$0")/.." && pwd)"
GEN="$HERE/internal/contractgen"
WORK="$(mktemp -d)"
trap 'rm -rf "$WORK"' EXIT

cd "$HERE/contracts"
forge build --silent
forge inspect LiabilityLedger abi --json > "$WORK/LiabilityLedger.abi"
forge inspect LiabilityLedger bytecode > "$WORK/LiabilityLedger.bin"
forge inspect ILiabilityLedger abi --json > "$WORK/ILiabilityLedger.abi"
forge inspect StatementCourt abi --json > "$WORK/StatementCourt.abi"
forge inspect StatementCourt bytecode > "$WORK/StatementCourt.bin"
forge inspect IStatementCourt abi --json > "$WORK/IStatementCourt.abi"
forge inspect WithholdingCourt abi --json > "$WORK/WithholdingCourt.abi"
forge inspect WithholdingCourt bytecode > "$WORK/WithholdingCourt.bin"
forge inspect IWithholdingCourt abi --json > "$WORK/IWithholdingCourt.abi"

rm -rf "$GEN"
mkdir -p "$GEN/ledger" "$GEN/ledgerinterface" "$GEN/court" "$GEN/courtinterface" "$GEN/withholding" "$GEN/withholdinginterface"
abigen --v2 \
  --abi "$WORK/LiabilityLedger.abi" \
  --bin "$WORK/LiabilityLedger.bin" \
  --pkg ledger \
  --type LiabilityLedger \
  --out "$GEN/ledger/liability_ledger.go"
abigen --v2 \
  --abi "$WORK/ILiabilityLedger.abi" \
  --pkg ledgerinterface \
  --type ILiabilityLedger \
  --out "$GEN/ledgerinterface/iliability_ledger.go"
abigen --v2 \
  --abi "$WORK/StatementCourt.abi" \
  --bin "$WORK/StatementCourt.bin" \
  --pkg court \
  --type StatementCourt \
  --out "$GEN/court/statement_court.go"
abigen --v2 \
  --abi "$WORK/IStatementCourt.abi" \
  --pkg courtinterface \
  --type IStatementCourt \
  --out "$GEN/courtinterface/istatement_court.go"
abigen --v2 \
  --abi "$WORK/WithholdingCourt.abi" \
  --bin "$WORK/WithholdingCourt.bin" \
  --pkg withholding \
  --type WithholdingCourt \
  --out "$GEN/withholding/withholding_court.go"
abigen --v2 \
  --abi "$WORK/IWithholdingCourt.abi" \
  --pkg withholdinginterface \
  --type IWithholdingCourt \
  --out "$GEN/withholdinginterface/iwithholding_court.go"

echo "generated $GEN"
