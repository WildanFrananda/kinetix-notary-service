#!/usr/bin/env sh
set -eu

HERE="$(cd "$(dirname "$0")/.." && pwd)"
VERSION="${1:-}"
OUT="${2:-}"

if [ -z "$VERSION" ] || [ -z "$OUT" ]; then
  echo "usage: bin/build-verifier-wasm <version> <output directory>   (needs the generated bindings: bin/generate)" >&2
  exit 64
fi

mkdir -p "$OUT"
OUT="$(cd "$OUT" && pwd)"
cd "$HERE"

GOOS=js GOARCH=wasm CGO_ENABLED=0 go build \
  -trimpath \
  -buildvcs=false \
  -ldflags="-s -w -X main.version=$VERSION" \
  -o "$OUT/notary-verify.wasm" \
  ./cmd/notary-verify-wasm

cp "$(go env GOROOT)/lib/wasm/wasm_exec.js" "$OUT/wasm_exec.js"

cd "$OUT"
sha256sum notary-verify.wasm wasm_exec.js > SHA256SUMS
cat SHA256SUMS
