#!/usr/bin/env sh
set -eu

HERE="$(cd "$(dirname "$0")/.." && pwd)"
cd "$HERE"

: "${KINETIX_NOTARY_TEST_RPC_URL:?bin/ci needs a node: run it as bin/dev bin/ci, or start anvil and set KINETIX_NOTARY_TEST_RPC_URL}"
: "${KINETIX_NOTARY_TEST_DATABASE_URL:?bin/ci needs Postgres: run it as bin/dev bin/ci, or set KINETIX_NOTARY_TEST_DATABASE_URL}"

sh bin/ci-contracts
sh bin/ci-go
