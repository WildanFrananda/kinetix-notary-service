#!/usr/bin/env sh
set -eu

HERE="$(cd "$(dirname "$0")/.." && pwd)"
NETWORK="${1:-}"

if [ -z "$NETWORK" ] || [ ! -f "$HERE/deploy/$NETWORK.env" ]; then
  echo "usage: bin/inspect-directory <network>   (reads deploy/<network>.env)" >&2
  exit 64
fi
: "${KINETIX_NOTARY_RPC_URL:?set KINETIX_NOTARY_RPC_URL to the network RPC endpoint}"

docker compose -f "$HERE/toolchain/compose.yaml" build --quiet toolchain >&2
exec docker compose -f "$HERE/toolchain/compose.yaml" run --rm --no-deps -T \
  -e KINETIX_NOTARY_RPC_URL toolchain sh -c '
  set -eu
  network="$1"
  set -a
  . "./deploy/$network.env"
  set +a
  directory="${KINETIX_NOTARY_DIRECTORY_ADDRESS:-}"
  if [ -z "$directory" ]; then
    echo "KINETIX_NOTARY_DIRECTORY_ADDRESS is empty in deploy/$network.env" >&2
    exit 78
  fi
  rpc="$KINETIX_NOTARY_RPC_URL"
  generation="(uint64,address,address,address,uint64,bytes32,uint16,uint64)"
  failed=0
  expect() {
    if [ "$(printf %s "$2" | tr A-F a-f)" = "$(printf %s "$3" | tr A-F a-f)" ]; then
      printf "  ok    %-24s %s\n" "$1" "$2"
    else
      printf "  WRONG %-24s %s (expected %s)\n" "$1" "$2" "$3"
      failed=1
    fi
  }
  show() {
    printf "        %-24s %s\n" "$1" "$2"
  }
  call() {
    cast call "$directory" "$@" --rpc-url "$rpc" | sed "s/ \[.*\]\$//"
  }
  field() {
    printf "%s\n" "$1" | sed -n "$2p" | sed "s/ \[.*\]\$//"
  }

  echo "ledger directory $directory on deploy/$network.env"
  expect "chain id" "$(cast chain-id --rpc-url "$rpc")" "$KINETIX_NOTARY_CHAIN_ID"
  code="$(cast code "$directory" --rpc-url "$rpc")"
  if [ "$code" = "0x" ]; then
    echo "  WRONG no contract at $directory"
    exit 1
  fi
  show "code bytes" "$(( (${#code} - 2) / 2 ))"
  expect "admin" "$(call "defaultAdmin()(address)")" "$KINETIX_NOTARY_DIRECTORY_ADMIN_ADDRESS"
  expect "admin transfer delay" "$(call "defaultAdminDelay()(uint48)")" "$KINETIX_NOTARY_DIRECTORY_ADMIN_TRANSFER_DELAY_SECONDS"
  expect "foreign successor delay" "$(call "foreignSuccessorDelay()(uint64)")" "$KINETIX_NOTARY_FOREIGN_SUCCESSOR_DELAY_SECONDS"
  count="$(call "generationCount()(uint256)")"
  show "generations" "$count"
  ledger="$(printf %s "${KINETIX_NOTARY_LEDGER_ADDRESS:-}" | tr A-F a-f)"
  index=0
  found=""
  while [ -n "$ledger" ] && [ "$index" -lt "$count" ]; do
    candidate="$(call "generation(uint256)$generation" "$index")"
    if [ "$(field "$candidate" 2 | tr A-F a-f)" = "$ledger" ]; then
      found="$candidate"
      break
    fi
    index=$((index + 1))
  done
  if [ -z "$found" ]; then
    printf "  WRONG %-24s %s\n" "generation" "the ledger ${KINETIX_NOTARY_LEDGER_ADDRESS:-(empty)} is no generation of this directory"
    failed=1
  else
    show "generation" "$index"
    expect "chain" "$(field "$found" 1)" "$KINETIX_NOTARY_CHAIN_ID"
    expect "ledger" "$(field "$found" 2)" "$KINETIX_NOTARY_LEDGER_ADDRESS"
    expect "court" "$(field "$found" 3)" "$KINETIX_NOTARY_COURT_ADDRESS"
    expect "withholding" "$(field "$found" 4)" "$KINETIX_NOTARY_WITHHOLDING_COURT_ADDRESS"
    expect "scheme" "$(field "$found" 7)" "${KINETIX_NOTARY_SCHEME:-1}"
    show "genesis epoch" "$(field "$found" 5)"
    show "registered at" "$(field "$found" 8)"
    if [ "$index" -eq "$((count - 1))" ]; then
      show "current" "yes"
    else
      show "current" "no: generation $((count - 1)) succeeds it"
    fi
  fi
  show "pending successor" "$(cast call "$directory" "pendingSuccessor()(($generation,uint64))" --rpc-url "$rpc")"
  if [ "${KINETIX_NOTARY_VERIFY_SOURCE:-}" = "true" ] && [ "${KINETIX_NOTARY_VERIFIER:-}" = "sourcify" ]; then
    verdict="$(curl -fsS --max-time 30 "https://sourcify.dev/server/v2/contract/$KINETIX_NOTARY_CHAIN_ID/$directory" \
      | python3 -c "import json, sys; print(json.load(sys.stdin).get(\"runtimeMatch\") or \"none\")" 2>/dev/null \
      || echo "unreachable")"
    case "$verdict" in
      match | exact_match) expect "source on sourcify" "$verdict" "$verdict" ;;
      unreachable) printf "  ?     %-24s %s\n" "source on sourcify" "sourcify could not be asked" ; failed=1 ;;
      *) expect "source on sourcify" "$verdict" "match" ;;
    esac
  fi
  exit "$failed"
' sh "$NETWORK"
