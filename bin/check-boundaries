#!/usr/bin/env sh
set -eu

HERE="$(cd "$(dirname "$0")/.." && pwd)"
cd "$HERE"

MODULE="$(go list -m)"
PACKAGES="$(go list -buildvcs=false -f '{{.ImportPath}}{{range .Imports}} {{.}}{{end}}' ./cmd/... ./internal/...)"
failed=0

external() {
  printf '%s\n' "$1" | grep -v "^$MODULE" | awk -F/ '$1 ~ /\./' || true
}

beyond_notary() {
  printf '%s\n' "$1" \
    | grep "^$MODULE/" \
    | grep -v -e "^$MODULE/internal/$2$" -e "^$MODULE/internal/notary$" \
    || true
}

deps="$(go list -deps "$MODULE/internal/notary")"
offenders="$(external "$deps")"
if [ -n "$offenders" ]; then
  echo "internal/notary must import only the standard library, but it reaches:"
  echo "$offenders" | sed 's/^/  /'
  failed=1
fi

for usecase in verifying anchoring proving watching registering answering approving sponsoring evidencing delivering; do
  deps="$(go list -deps "$MODULE/internal/$usecase")"
  offenders="$(
    beyond_notary "$deps" "$usecase"
    external "$deps"
  )"
  if [ -n "$offenders" ]; then
    echo "internal/$usecase may import only internal/notary and the standard library, but it reaches:"
    echo "$offenders" | sed 's/^/  /'
    failed=1
  fi
done

deps="$(go list -deps "$MODULE/internal/bundler")"
offenders="$(
  beyond_notary "$deps" bundler
  external "$deps"
)"
if [ -n "$offenders" ]; then
  echo "internal/bundler speaks JSON-RPC with the standard library and may import only internal/notary, but it reaches:"
  echo "$offenders" | sed 's/^/  /'
  failed=1
fi

imports() {
  printf '%s\n' "$PACKAGES" \
    | awk -v dep="$1" '{ for (i = 2; i <= NF; i++) if (index($i, dep) == 1) { print $1; break } }'
}

offenders="$(imports go.uber.org/dig | grep -v -e "^$MODULE/cmd/" -e "^$MODULE/internal/wiring$" || true)"
if [ -n "$offenders" ]; then
  echo "dig belongs to the composition root (cmd/ and internal/wiring), but these import it:"
  echo "$offenders" | sed 's/^/  /'
  failed=1
fi

offenders="$(
  imports github.com/ethereum/go-ethereum \
    | grep -v -e "^$MODULE/cmd/" -e "^$MODULE/internal/wiring$" -e "^$MODULE/internal/ethereum$" -e "^$MODULE/internal/contractgen/" \
    || true
)"
if [ -n "$offenders" ]; then
  echo "go-ethereum belongs to internal/ethereum, but these import it:"
  echo "$offenders" | sed 's/^/  /'
  failed=1
fi

offenders="$(
  imports github.com/consensys/gnark \
    | grep -v -e "^$MODULE/cmd/" -e "^$MODULE/internal/wiring$" -e "^$MODULE/internal/poseidon$" -e "^$MODULE/internal/plonk$" \
      -e "^$MODULE/internal/ignition$" \
    || true
)"
if [ -n "$offenders" ]; then
  echo "gnark and gnark-crypto belong to internal/poseidon, internal/plonk and internal/ignition, but these import them:"
  echo "$offenders" | sed 's/^/  /'
  failed=1
fi

offenders="$(
  { imports google.golang.org/grpc; imports google.golang.org/protobuf; } \
    | grep -v -e "^$MODULE/cmd/" -e "^$MODULE/internal/wiring$" -e "^$MODULE/internal/payment$" \
      -e "^$MODULE/internal/mesh$" -e "^$MODULE/internal/metrics$" -e "^$MODULE/internal/protogen/" \
      -e "^$MODULE/internal/epochwatch$" -e "^$MODULE/internal/feeds$" -e "^$MODULE/internal/notification$" \
    || true
)"
if [ -n "$offenders" ]; then
  echo "gRPC belongs to the gRPC adapters (payment, feeds, notification, mesh, metrics, epochwatch), but these import it:"
  echo "$offenders" | sed 's/^/  /'
  failed=1
fi

offenders="$(
  { imports github.com/jackc/pgx; imports github.com/pressly/goose; } \
    | grep -v -e "^$MODULE/cmd/" -e "^$MODULE/internal/wiring$" -e "^$MODULE/internal/postgres$" -e "^$MODULE/internal/storegen$" \
    || true
)"
if [ -n "$offenders" ]; then
  echo "Postgres belongs to internal/postgres, but these import it:"
  echo "$offenders" | sed 's/^/  /'
  failed=1
fi

if [ "$failed" -ne 0 ]; then
  exit 1
fi
echo "boundaries hold: notary is pure, the use cases see only notary, the bundler only the standard library, dig, go-ethereum, gRPC and Postgres stay at the edge"
