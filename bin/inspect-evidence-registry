#!/usr/bin/env sh
set -eu

HERE="$(cd "$(dirname "$0")/.." && pwd)"
NETWORK="${1:-}"

if [ -z "$NETWORK" ] || [ ! -f "$HERE/deploy/$NETWORK.env" ]; then
  echo "usage: bin/inspect-evidence-registry <network>   (reads deploy/<network>.env)" >&2
  exit 64
fi
: "${KINETIX_NOTARY_RPC_URL:?set KINETIX_NOTARY_RPC_URL to the network RPC endpoint}"

docker compose -f "$HERE/toolchain/compose.yaml" build --quiet toolchain >&2
exec docker compose -f "$HERE/toolchain/compose.yaml" run --rm --no-deps -T \
  -e KINETIX_NOTARY_RPC_URL toolchain sh -c '
  set -eu
  network="$1"
  set -a
  . "./deploy/$network.env"
  set +a
  registry="${KINETIX_NOTARY_EVIDENCE_REGISTRY_ADDRESS:-}"
  if [ -z "$registry" ]; then
    echo "KINETIX_NOTARY_EVIDENCE_REGISTRY_ADDRESS is empty in deploy/$network.env" >&2
    exit 78
  fi
  rpc="$KINETIX_NOTARY_RPC_URL"
  failed=0
  expect() {
    if [ "$(printf %s "$2" | tr A-F a-f)" = "$(printf %s "$3" | tr A-F a-f)" ]; then
      printf "  ok    %-24s %s\n" "$1" "$2"
    else
      printf "  WRONG %-24s %s (expected %s)\n" "$1" "$2" "$3"
      failed=1
    fi
  }
  show() {
    printf "        %-24s %s\n" "$1" "$2"
  }
  call() {
    cast call "$registry" "$@" --rpc-url "$rpc" | sed "s/ \[.*\]\$//"
  }

  echo "evidence registry $registry on deploy/$network.env"
  expect "chain id" "$(cast chain-id --rpc-url "$rpc")" "$KINETIX_NOTARY_CHAIN_ID"
  code="$(cast code "$registry" --rpc-url "$rpc")"
  if [ "$code" = "0x" ]; then
    echo "  WRONG no contract at $registry"
    exit 1
  fi
  show "code bytes" "$(( (${#code} - 2) / 2 ))"
  interface="$(cd contracts && forge inspect IEvidenceRegistry methodIdentifiers --json | python3 -c "
import json, sys
value = 0
for selector in json.load(sys.stdin).values():
    value ^= int(selector, 16)
print(\"0x%08x\" % value)
")"
  expect "announces the interface" "$(call "supportsInterface(bytes4)(bool)" "$interface")" "true"
  expect "scheme" "$(call "scheme()(uint16)")" "1"
  expect "streams" "$(call "streams()(uint8[])")" "[1, 2, 3]"
  expect "admin" "$(call "defaultAdmin()(address)")" "$KINETIX_NOTARY_EVIDENCE_ADMIN_ADDRESS"
  expect "admin transfer delay" "$(call "defaultAdminDelay()(uint48)")" "$KINETIX_NOTARY_EVIDENCE_ADMIN_TRANSFER_DELAY_SECONDS"
  role="$(call "ANCHORER_ROLE()(bytes32)")"
  expect "evidence anchorer holds the role" "$(call "hasRole(bytes32,address)(bool)" "$role" "$KINETIX_NOTARY_EVIDENCE_ANCHORER_ADDRESS")" "true"
  expect "liabilities anchorer lacks it" "$(call "hasRole(bytes32,address)(bool)" "$role" "$KINETIX_NOTARY_ANCHORER_ADDRESS")" "false"
  expect "sealed" "$(call "isSealed()(bool)")" "false"
  for stream in 1 2 3; do
    show "stream $stream" "$(cast call "$registry" "stateOf(uint8)((bool,bytes32,uint64,uint64,uint64,uint64,uint64))" "$stream" --rpc-url "$rpc")"
  done
  show "evidence anchorer balance" "$(cast balance --ether "$KINETIX_NOTARY_EVIDENCE_ANCHORER_ADDRESS" --rpc-url "$rpc") ETH"
  if [ "${KINETIX_NOTARY_VERIFY_SOURCE:-}" = "true" ] && [ "${KINETIX_NOTARY_VERIFIER:-}" = "sourcify" ]; then
    verdict="$(curl -fsS --max-time 30 "https://sourcify.dev/server/v2/contract/$KINETIX_NOTARY_CHAIN_ID/$registry" \
      | python3 -c "import json, sys; print(json.load(sys.stdin).get(\"runtimeMatch\") or \"none\")" 2>/dev/null \
      || echo "unreachable")"
    case "$verdict" in
      match | exact_match) expect "source on sourcify" "$verdict" "$verdict" ;;
      unreachable) printf "  ?     %-24s %s\n" "source on sourcify" "sourcify could not be asked" ; failed=1 ;;
      *) expect "source on sourcify" "$verdict" "match" ;;
    esac
  fi
  exit "$failed"
' sh "$NETWORK"
