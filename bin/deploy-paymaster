#!/usr/bin/env sh
set -eu

HERE="$(cd "$(dirname "$0")/.." && pwd)"
NETWORK="${1:-}"
MODE="${2:-}"

case "$MODE" in
  "" | --broadcast) ;;
  *)
    echo "usage: bin/deploy-paymaster <network> [--broadcast]" >&2
    exit 64
    ;;
esac
if [ -z "$NETWORK" ] || [ ! -f "$HERE/deploy/$NETWORK.env" ]; then
  echo "usage: bin/deploy-paymaster <network> [--broadcast]   (reads deploy/<network>.env)" >&2
  exit 64
fi
: "${KINETIX_NOTARY_RPC_URL:?set KINETIX_NOTARY_RPC_URL to the network RPC endpoint}"
KEYSTORES="$(sh "$HERE/bin/keystore-dir")"
if [ ! -f "$KEYSTORES/notary-deployer" ]; then
  echo "no notary-deployer keystore in $KEYSTORES: run bin/new-keystore notary-deployer" >&2
  exit 1
fi

set -- run --rm --no-deps -e KINETIX_NOTARY_RPC_URL -v "$KEYSTORES:/keystores:ro"
PASSWORD_ARG=""
if [ -n "${KINETIX_NOTARY_KEYSTORE_PASSWORD_FILE:-}" ]; then
  set -- "$@" -v "$KINETIX_NOTARY_KEYSTORE_PASSWORD_FILE:/run/keystore-password:ro"
  PASSWORD_ARG=--password-file
fi

docker compose -f "$HERE/toolchain/compose.yaml" build --quiet toolchain >&2
exec docker compose -f "$HERE/toolchain/compose.yaml" "$@" toolchain sh -c '
  set -eu
  network="$1"
  mode="$2"
  password_arg="$3"
  set -a
  . "./deploy/$network.env"
  set +a
  for key in KINETIX_NOTARY_CHAIN_ID KINETIX_NOTARY_VERIFY_SOURCE KINETIX_NOTARY_COURT_ADDRESS \
    KINETIX_NOTARY_WITHHOLDING_COURT_ADDRESS KINETIX_NOTARY_PAYMASTER_ADMIN_ADDRESS \
    KINETIX_NOTARY_PAYMASTER_ADMIN_TRANSFER_DELAY_SECONDS KINETIX_NOTARY_ENTRY_POINT_ADDRESS \
    KINETIX_NOTARY_ENTRY_POINT_CODEHASH KINETIX_NOTARY_7702_ACCOUNT_ADDRESS KINETIX_NOTARY_7702_ACCOUNT_CODEHASH \
    KINETIX_NOTARY_PAYMASTER_MAX_COST_WEI KINETIX_NOTARY_PAYMASTER_UNSTAKE_DELAY_SECONDS \
    KINETIX_NOTARY_PAYMASTER_DEPLOY_SALT; do
    eval "value=\${$key:-}"
    if [ -z "$value" ]; then
      echo "$key is empty in deploy/$network.env" >&2
      exit 78
    fi
  done
  rpc="$KINETIX_NOTARY_RPC_URL"
  served="$(cast chain-id --rpc-url "$rpc")"
  if [ "$served" != "$KINETIX_NOTARY_CHAIN_ID" ]; then
    echo "the RPC endpoint serves chain $served, deploy/$network.env is for chain $KINETIX_NOTARY_CHAIN_ID" >&2
    exit 1
  fi
  for pinned in "EntryPoint $KINETIX_NOTARY_ENTRY_POINT_ADDRESS $KINETIX_NOTARY_ENTRY_POINT_CODEHASH" \
    "Simple7702Account $KINETIX_NOTARY_7702_ACCOUNT_ADDRESS $KINETIX_NOTARY_7702_ACCOUNT_CODEHASH"; do
    set -- $pinned
    found="$(cast keccak "$(cast code "$2" --rpc-url "$rpc")")"
    if [ "$(printf %s "$found" | tr A-F a-f)" != "$(printf %s "$3" | tr A-F a-f)" ]; then
      echo "the $1 at $2 has code hash $found, deploy/$network.env pins $3" >&2
      exit 1
    fi
  done
  for contract in "$KINETIX_NOTARY_COURT_ADDRESS" "$KINETIX_NOTARY_WITHHOLDING_COURT_ADDRESS"; do
    if [ "$(cast code "$contract" --rpc-url "$rpc")" = "0x" ]; then
      echo "there is no contract at $contract for the paymaster to sponsor" >&2
      exit 1
    fi
  done
  if [ -n "${KINETIX_NOTARY_PAYMASTER_ADDRESS:-}" ] \
    && [ "$(cast code "$KINETIX_NOTARY_PAYMASTER_ADDRESS" --rpc-url "$rpc")" != "0x" ]; then
    echo "deploy/$network.env already names a deployed paymaster at $KINETIX_NOTARY_PAYMASTER_ADDRESS" >&2
    exit 1
  fi

  cd contracts
  forge soldeer install >/dev/null
  set -- script/DeployNotaryPaymaster.s.sol:DeployNotaryPaymaster \
    --rpc-url "$rpc" --keystore /keystores/notary-deployer
  if [ -n "$password_arg" ]; then
    set -- "$@" --password-file /run/keystore-password
  fi
  if [ "$mode" = "--broadcast" ]; then
    set -- "$@" --broadcast --slow
    case "$KINETIX_NOTARY_VERIFY_SOURCE" in
      true)
        if [ -z "${KINETIX_NOTARY_VERIFIER:-}" ]; then
          echo "KINETIX_NOTARY_VERIFY_SOURCE is true but KINETIX_NOTARY_VERIFIER is empty" >&2
          exit 78
        fi
        set -- "$@" --verify --verifier "$KINETIX_NOTARY_VERIFIER"
        if [ -n "${KINETIX_NOTARY_VERIFIER_URL:-}" ]; then
          set -- "$@" --verifier-url "$KINETIX_NOTARY_VERIFIER_URL"
        fi
        ;;
      false) ;;
      *)
        echo "KINETIX_NOTARY_VERIFY_SOURCE must be true or false" >&2
        exit 78
        ;;
    esac
  fi
  forge script "$@"
  if [ "$mode" != "--broadcast" ]; then
    echo
    echo "dry run only: nothing was sent. Re-run with --broadcast to deploy."
  else
    echo
    echo "the paymaster holds no stake and no deposit yet: bin/stake-paymaster $network, then"
    echo "bin/fund-paymaster $network <ether>, before anyone is sponsored."
    echo "forge reports verification optimistically; bin/inspect-paymaster checks it against the verifier itself."
  fi
' sh "$NETWORK" "$MODE" "$PASSWORD_ARG"
