#!/usr/bin/env sh
set -eu

HERE="$(cd "$(dirname "$0")/.." && pwd)"
NETWORK="${1:-}"
PROOF="${2:-}"
MODE="${3:-}"

case "$MODE" in
  "" | --broadcast) ;;
  *)
    echo "usage: bin/retire-anchorer <network> <tx of an anchor through the council> [--broadcast]" >&2
    exit 64
    ;;
esac
if [ -z "$NETWORK" ] || [ ! -f "$HERE/deploy/$NETWORK.env" ] || [ -z "$PROOF" ]; then
  echo "usage: bin/retire-anchorer <network> <tx of an anchor through the council> [--broadcast]" >&2
  exit 64
fi
: "${KINETIX_NOTARY_RPC_URL:?set KINETIX_NOTARY_RPC_URL to the network RPC endpoint}"
KEYSTORES="$(sh "$HERE/bin/keystore-dir")"
if [ ! -f "$KEYSTORES/notary-admin" ]; then
  echo "no notary-admin keystore in $KEYSTORES: the ledger's admin revokes the role" >&2
  exit 1
fi

set -- run --rm --no-deps -e KINETIX_NOTARY_RPC_URL -v "$KEYSTORES:/keystores:ro"
PASSWORD_ARG=""
if [ -n "${KINETIX_NOTARY_KEYSTORE_PASSWORD_FILE:-}" ]; then
  set -- "$@" -v "$KINETIX_NOTARY_KEYSTORE_PASSWORD_FILE:/run/keystore-password:ro"
  PASSWORD_ARG=--password-file
fi

docker compose -f "$HERE/toolchain/compose.yaml" build --quiet toolchain >&2
exec docker compose -f "$HERE/toolchain/compose.yaml" "$@" toolchain sh -c '
  set -eu
  network="$1"
  proof="$2"
  mode="$3"
  password_arg="$4"
  set -a
  . "./deploy/$network.env"
  set +a
  for key in KINETIX_NOTARY_CHAIN_ID KINETIX_NOTARY_LEDGER_ADDRESS KINETIX_NOTARY_ADMIN_ADDRESS \
    KINETIX_NOTARY_COUNCIL_ADDRESS KINETIX_NOTARY_ANCHORER_ADDRESS; do
    eval "value=\${$key:-}"
    if [ -z "$value" ]; then
      echo "$key is empty in deploy/$network.env" >&2
      exit 78
    fi
  done
  rpc="$KINETIX_NOTARY_RPC_URL"
  ledger="$(printf %s "$KINETIX_NOTARY_LEDGER_ADDRESS" | tr A-F a-f)"
  council="$(printf %s "$KINETIX_NOTARY_COUNCIL_ADDRESS" | tr A-F a-f)"
  anchorer="$KINETIX_NOTARY_ANCHORER_ADDRESS"
  served="$(cast chain-id --rpc-url "$rpc")"
  if [ "$served" != "$KINETIX_NOTARY_CHAIN_ID" ]; then
    echo "the RPC endpoint serves chain $served, deploy/$network.env is for chain $KINETIX_NOTARY_CHAIN_ID" >&2
    exit 1
  fi
  role="$(cast call "$ledger" "ANCHORER_ROLE()(bytes32)" --rpc-url "$rpc")"
  if [ "$(cast call "$ledger" "hasRole(bytes32,address)(bool)" "$role" "$council" --rpc-url "$rpc")" != "true" ]; then
    echo "the council does not hold the anchorer role; retiring the anchorer key now would stop anchoring" >&2
    exit 1
  fi
  if [ "$(cast call "$ledger" "hasRole(bytes32,address)(bool)" "$role" "$anchorer" --rpc-url "$rpc")" != "true" ]; then
    echo "the anchorer key $anchorer no longer holds the role; nothing to do"
    exit 0
  fi

  to="$(cast tx "$proof" to --rpc-url "$rpc" | tr A-F a-f)"
  status="$(cast receipt "$proof" status --rpc-url "$rpc")"
  anchored="$(cast keccak "EpochAnchored(uint64,bytes32,bytes32,bytes32,uint64,uint64,uint64)")"
  emitted="$(cast receipt "$proof" logs --rpc-url "$rpc" | tr A-F a-f | grep -c "$anchored" || true)"
  case "$status" in
    true | "1 (success)") succeeded=yes ;;
    *) succeeded=no ;;
  esac
  if [ "$to" != "$council" ] || [ "$succeeded" != "yes" ] || [ "$emitted" = "0" ]; then
    echo "$proof is not a successful anchor sent to the council $council (to $to, status $status)" >&2
    exit 1
  fi
  cast receipt "$proof" logs --rpc-url "$rpc" | tr A-F a-f | grep -q "$ledger" || {
    echo "$proof anchored nothing on the ledger $ledger" >&2
    exit 1
  }

  cast call "$ledger" "revokeRole(bytes32,address)" "$role" "$anchorer" --from "$KINETIX_NOTARY_ADMIN_ADDRESS" --rpc-url "$rpc" >/dev/null
  if [ "$mode" != "--broadcast" ]; then
    echo "dry run: the council anchored through $proof, and the admin may revoke the anchorer role from $anchorer."
    echo "nothing was sent. Re-run with --broadcast to revoke it."
    exit 0
  fi

  set -- "$ledger" "revokeRole(bytes32,address)" "$role" "$anchorer" --rpc-url "$rpc" --keystore /keystores/notary-admin
  if [ -n "$password_arg" ]; then
    set -- "$@" --password-file /run/keystore-password
  fi
  cast send "$@"
  waited=0
  until [ "$(cast call "$ledger" "hasRole(bytes32,address)(bool)" "$role" "$anchorer" --rpc-url "$rpc")" = "false" ]; do
    if [ "$waited" -ge 60 ]; then
      echo "the revocation was sent, but the anchorer key still holds the role at the latest block after 60 s" >&2
      exit 1
    fi
    sleep 2
    waited=$((waited + 2))
  done
  echo "the anchorer key $anchorer no longer anchors alone; only the council $council anchors $ledger"
' sh "$NETWORK" "$PROOF" "$MODE" "$PASSWORD_ARG"
