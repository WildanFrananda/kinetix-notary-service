#!/usr/bin/env sh
set -eu

FOUNDRY_VERSION=v1.8.3
FOUNDRY_SHA256_AMD64=7ca48e6ca3cac1bce1403ca67e5bc1dc3bc1fd818199c9957c7165079c228568
FOUNDRY_SHA256_ARM64=93fc23be26c8a902ca58fe54aa6ca28c880b58af95d052674933161df7928e6d
ABIGEN_VERSION=v1.17.8
GOLANGCI_LINT_VERSION=v2.13.2
ADERYN_VERSION=v0.6.8
ADERYN_SHA256_X86_64=ffd6ca658962e211a3ac821c646f69c8e14bf1b1001cbfe091bcd4535a691e46
ADERYN_SHA256_AARCH64=961070bf5ee4ed0f82f67a261c616e1525ec1b036bae60cdaec94d087eb5e405
PROTOC_VERSION=36.2
PROTOC_SHA256_X86_64=121f6c7afe1d4d0e3ea6aab9432038599250134cbf4474cb1167d2c7decd4278
PROTOC_SHA256_AARCH_64=8b8f18bd2b30346efbc698dd5a73dd7c805f3ef8380f6dfc95c768f3f1852f6a
PROTOC_GEN_GO_VERSION=v1.36.12
PROTOC_GEN_GO_GRPC_VERSION=v1.6.2
SQLC_VERSION=1.31.1
SQLC_SHA256_AMD64=497ae4fcdfa64c5b0c311ffe4c2bd991e43991e82e5367792ed78bc2dca27354
SQLC_SHA256_ARM64=b7cae247740d0c51a1e657479e5b2d21e6fef428f596682a01bc55bf4ab8a23d
BUN_VERSION=1.3.14
BUN_SHA256_X64=951ee2aee855f08595aeec6225226a298d3fea83a3dcd6465c09cbccdf7e848f
BUN_SHA256_AARCH64=a27ffb63a8310375836e0d6f668ae17fa8d8d18b88c37c821c65331973a19a3b

HERE="$(cd "$(dirname "$0")/.." && pwd)"

usage() {
  echo "usage: bin/install-toolchain <directory on PATH> <foundry|abigen|protobuf|sqlc|lint|analysis|bun>..." >&2
  exit 64
}

[ "$#" -ge 2 ] || usage
PREFIX="$1"
shift
mkdir -p "$PREFIX"

case "$(uname -m)" in
  x86_64 | amd64)
    arch=amd64
    rust_arch=x86_64
    protoc_arch=x86_64
    bun_arch=x64
    foundry_sum=$FOUNDRY_SHA256_AMD64
    aderyn_sum=$ADERYN_SHA256_X86_64
    protoc_sum=$PROTOC_SHA256_X86_64
    sqlc_sum=$SQLC_SHA256_AMD64
    bun_sum=$BUN_SHA256_X64
    ;;
  aarch64 | arm64)
    arch=arm64
    rust_arch=aarch64
    protoc_arch=aarch_64
    bun_arch=aarch64
    foundry_sum=$FOUNDRY_SHA256_ARM64
    aderyn_sum=$ADERYN_SHA256_AARCH64
    protoc_sum=$PROTOC_SHA256_AARCH_64
    sqlc_sum=$SQLC_SHA256_ARM64
    bun_sum=$BUN_SHA256_AARCH64
    ;;
  *)
    echo "no pinned toolchain for $(uname -m)" >&2
    exit 1
    ;;
esac

work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT

fetch() {
  curl -fsSL --retry 3 -o "$2" "$1"
  echo "$3  $2" | sha256sum -c -
}

install_foundry() {
  archive="foundry_${FOUNDRY_VERSION}_linux_${arch}.tar.gz"
  fetch "https://github.com/foundry-rs/foundry/releases/download/${FOUNDRY_VERSION}/${archive}" \
    "$work/$archive" "$foundry_sum"
  tar -xzf "$work/$archive" -C "$work" forge cast anvil
  install -m 0755 "$work/forge" "$work/cast" "$work/anvil" "$PREFIX/"
  "$PREFIX/forge" --version
}

install_abigen() {
  GOBIN="$PREFIX" go install "github.com/ethereum/go-ethereum/cmd/abigen@${ABIGEN_VERSION}"
  "$PREFIX/abigen" --version
}

install_protobuf() {
  archive="protoc-${PROTOC_VERSION}-linux-${protoc_arch}.zip"
  fetch "https://github.com/protocolbuffers/protobuf/releases/download/v${PROTOC_VERSION}/${archive}" \
    "$work/$archive" "$protoc_sum"
  unzip -q "$work/$archive" -d "$work/protoc"
  install -m 0755 "$work/protoc/bin/protoc" "$PREFIX/"
  include="$(dirname "$PREFIX")/include"
  mkdir -p "$include"
  cp -R "$work/protoc/include/google" "$include/"
  GOBIN="$PREFIX" go install "google.golang.org/protobuf/cmd/protoc-gen-go@${PROTOC_GEN_GO_VERSION}"
  GOBIN="$PREFIX" go install "google.golang.org/grpc/cmd/protoc-gen-go-grpc@${PROTOC_GEN_GO_GRPC_VERSION}"
  "$PREFIX/protoc" --version
  "$PREFIX/protoc-gen-go" --version
  "$PREFIX/protoc-gen-go-grpc" --version
}

install_sqlc() {
  archive="sqlc_${SQLC_VERSION}_linux_${arch}.tar.gz"
  fetch "https://github.com/sqlc-dev/sqlc/releases/download/v${SQLC_VERSION}/${archive}" \
    "$work/$archive" "$sqlc_sum"
  tar -xzf "$work/$archive" -C "$work" sqlc
  install -m 0755 "$work/sqlc" "$PREFIX/"
  "$PREFIX/sqlc" version
}

install_lint() {
  GOBIN="$PREFIX" go install "github.com/golangci/golangci-lint/v2/cmd/golangci-lint@${GOLANGCI_LINT_VERSION}"
  "$PREFIX/golangci-lint" --version
}

install_analysis() {
  venv="$(dirname "$PREFIX")/lib/kinetix-slither"
  python3 -m venv "$venv"
  "$venv/bin/pip" install --quiet --require-hashes --no-deps -r "$HERE/toolchain/slither-requirements.txt"
  ln -sf "$venv/bin/slither" "$PREFIX/slither"
  archive="aderyn-${rust_arch}-unknown-linux-gnu.tar.xz"
  fetch "https://github.com/Cyfrin/aderyn/releases/download/aderyn-${ADERYN_VERSION}/${archive}" \
    "$work/$archive" "$aderyn_sum"
  tar -xJf "$work/$archive" -C "$work"
  install -m 0755 "$work/aderyn-${rust_arch}-unknown-linux-gnu/aderyn" "$PREFIX/"
  "$PREFIX/slither" --version
  "$PREFIX/aderyn" --version
}

install_bun() {
  archive="bun-linux-${bun_arch}.zip"
  fetch "https://github.com/oven-sh/bun/releases/download/bun-v${BUN_VERSION}/${archive}" \
    "$work/$archive" "$bun_sum"
  unzip -q "$work/$archive" -d "$work"
  install -m 0755 "$work/bun-linux-${bun_arch}/bun" "$PREFIX/"
  "$PREFIX/bun" --version
}

for component in "$@"; do
  case "$component" in
    foundry) install_foundry ;;
    abigen) install_abigen ;;
    protobuf) install_protobuf ;;
    sqlc) install_sqlc ;;
    lint) install_lint ;;
    analysis) install_analysis ;;
    bun) install_bun ;;
    *) usage ;;
  esac
done
